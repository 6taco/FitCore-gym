{
  "name": "jianshenfang",
  "private": true,
  "version": "0.1.0",
  "description": "健身房管理系统（React + Node.js + MySQL）",
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "full-check": "npm --prefix server run full-check",
    "full-check:clean": "npm --prefix server run full-check:clean"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
